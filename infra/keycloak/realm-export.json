{
  "realm": "talentflow",
  "displayName": "TalentFlow",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "verifyEmail": true,
  "passwordPolicy": "length(10) and digits(1) and notUsername and notEmail",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "smtpServer": {
    "host": "${KEYCLOAK_SMTP_HOST:mailpit}",
    "port": "${KEYCLOAK_SMTP_PORT:1025}",
    "from": "no-reply@talentflow.dev",
    "fromDisplayName": "TalentFlow",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "rememberMe": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "en",
    "de"
  ],
  "defaultLocale": "en",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "CANDIDATE",
        "description": "Applies to jobs and manages own data"
      },
      {
        "name": "RECRUITER",
        "description": "Manages jobs, applications and the pipeline"
      },
      {
        "name": "HIRING_MANAGER",
        "description": "Reviews assigned candidates and gives interview feedback"
      },
      {
        "name": "ADMIN",
        "description": "Manages users, data retention and the audit log"
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-talentflow",
        "description": "Roles granted to self-registered users",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "CANDIDATE"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-talentflow",
    "composite": true
  },
  "clients": [
    {
      "clientId": "talentflow-frontend",
      "name": "TalentFlow web app",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${FRONTEND_URL:http://localhost:3000}",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*",
        "${FRONTEND_URL:http://localhost:3000}/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*##${FRONTEND_URL:http://localhost:3000}/*"
      },
      "protocolMappers": [
        {
          "name": "talentflow-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "talentflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "talentflow-api",
      "name": "TalentFlow API",
      "description": "Audience for access tokens validated by the backend",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "talentflow-admin-api",
      "name": "TalentFlow backend (user administration)",
      "description": "Service account used by the backend to manage users and roles",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
