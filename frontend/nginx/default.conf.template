# Rendered by the nginx image at startup: ${KEYCLOAK_URL} comes from the container environment.
server_tokens off;

# keycloak-js loads silent-check-sso.html in a hidden same-origin iframe; nothing else may be framed.
map $uri $frame_ancestors {
    /silent-check-sso.html "'self'";
    default "'none'";
}

map $uri $frame_options {
    /silent-check-sso.html "SAMEORIGIN";
    default "DENY";
}

map $host $content_security_policy {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ${KEYCLOAK_URL}; frame-src 'self' blob: ${KEYCLOAK_URL}; frame-ancestors $frame_ancestors; object-src 'none'; base-uri 'self'; form-action 'self' ${KEYCLOAK_URL}";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    include /etc/nginx/snippets/security-headers.conf;

    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # add_header in a location replaces the server-level headers, so repeat them here.
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
