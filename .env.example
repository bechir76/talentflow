# Copy to .env and adjust. Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=talentflow
POSTGRES_USER=talentflow
POSTGRES_PASSWORD=change-me

# Keycloak bootstrap admin (admin console at http://localhost:8180)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Host ports (change if they clash with something already running locally)
BACKEND_PORT=8080
FRONTEND_PORT=3000
