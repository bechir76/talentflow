# Copy to .env and adjust. Never commit the real .env file.

# PostgreSQL
POSTGRES_DB=talentflow
POSTGRES_USER=talentflow
POSTGRES_PASSWORD=change-me

# Keycloak bootstrap admin (admin console at http://localhost:8180)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Host ports (change if they clash with something already running locally).
# Keycloak's port is also baked into token issuers and the frontend build.
BACKEND_PORT=8080
FRONTEND_PORT=3000
KEYCLOAK_PORT=8180

# AI screening (optional). Without an API key a deterministic offline analyzer is used.
# Any OpenAI-compatible chat completions API works, e.g. https://api.openai.com/v1 or a local Ollama.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-small-latest
